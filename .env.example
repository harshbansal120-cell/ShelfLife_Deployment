# Copy to .env and fill in. .env is gitignored.
# Keep comments on their own lines: a comment after an empty value is read as the value.

# --- Backend ---------------------------------------------------------------
TAVILY_API_KEY=tvly-...
BIFROST_URL=http://127.0.0.1:8080
# Virtual key created in the Bifrost UI. Leave empty until you have one.
BIFROST_VK=

# Use provider/model names from providers configured in Bifrost.
# MODEL_FAST below is an example only.
MODEL_FAST=openai/gpt-4o-mini
MODEL_STRONG=
# An older/cheaper model, used only for the demo generator.
MODEL_STALE=

# Comma-separated provider/model lists, tried in order.
FALLBACKS_FAST=
FALLBACKS_STRONG=

MAX_CLAIMS=12
TAVILY_CONCURRENCY=3
LLM_CONCURRENCY=4
# Read thin official pages in full with Tavily Extract (costs extra credits).
USE_TAVILY_EXTRACT=true
SEARCH_CACHE_TTL_HOURS=6
# Run against a built-in simulator with invented data: no keys and no credits needed.
DEMO_MODE=false
# Optional: POST a JSON alert to this URL when a check finds stale claims.
ALERT_WEBHOOK_URL=
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Bifrost admin (docker compose, scripts/bifrost_setup.py, and the System page's cache status) ---
# Any long random string. Needed before creating the first Bifrost admin account.
# bifrost_setup.py also uses it for admin calls until a dashboard password is set.
BIFROST_SETUP_TOKEN=
# Only if the Bifrost dashboard is password-protected: used by bifrost_setup.py.
BIFROST_ADMIN_USER=
BIFROST_ADMIN_PASSWORD=
# Optional: only needed if a bifrost/config.json refers to them as env.NAME.
# Otherwise add provider keys in the Bifrost web UI.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
